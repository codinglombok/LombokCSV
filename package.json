{
  "name": "lombokcsv",
  "version": "1.1.0",
  "description": "RFC 4180 CSV parser with type detection, safe HTML tables, JSON export and GROUP BY aggregation. Zero dependencies. Part of the Lombok Ecosystem.",
  "keywords": [
    "csv",
    "rfc4180",
    "parser",
    "html-table",
    "aggregate",
    "group-by",
    "type-detection",
    "zero-dependency",
    "lombok-ecosystem"
  ],
  "license": "Apache-2.0",
  "author": "codinglombok (https://github.com/codinglombok)",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "fuzz": "npm run build && tsx tests/fuzz/csv.fuzz.ts",
    "vectors": "python3 vectors/build_vectors.py",
    "doctor": "bash scripts/lombok-doctor.sh LombokCSV",
    "check": "npm run lint && npm run coverage && npm run build && npm run doctor"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^5.0.3",
    "lombokfuzzer": "^0.1.0",
    "tsup": "^8.0.0",
    "vitest": "^5.0.3",
    "typescript": "^5.0.0",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codinglombok/LombokCSV.git"
  },
  "homepage": "https://codinglombok.github.io/LombokCSV",
  "bugs": {
    "url": "https://github.com/codinglombok/LombokCSV/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
